<!-- ============ NEWS (scrolling box) ============ -->
<section id="news" class="section">
  <h2 class="section-title">News</h2>
  <div class="news-scroll" tabindex="0" aria-label="News, scrollable">
    <ul class="news-list">
      {% for item in site.data.news %}
        {%- case item.icon -%}
          {%- when 'paper' -%}{%- assign ico = 'fa-regular fa-file-lines' -%}
          {%- when 'award' -%}{%- assign ico = 'fa-solid fa-trophy' -%}
          {%- when 'talk' -%}{%- assign ico = 'fa-solid fa-microphone' -%}
          {%- when 'school' -%}{%- assign ico = 'fa-solid fa-graduation-cap' -%}
          {%- else -%}{%- assign ico = 'fa-solid fa-circle dot' -%}
        {%- endcase -%}
        <li class="news-item">
          <span class="date">{{ item.date }}</span>
          <i class="news-icon {{ ico }}" aria-hidden="true"></i>
          <span class="news-text">{{ item.text | markdownify | remove: '<p>' | remove: '</p>' | strip }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>
