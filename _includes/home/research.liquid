<!-- ============ RESEARCH ============ -->
{%- assign research = site.data.research -%}
<section id="research" class="section">
  <h2 class="section-title">Research</h2>
  <div class="prose">
    {{ research.statement | markdownify }}
    {% if research.tools_intro %}{{ research.tools_intro | markdownify }}{% endif %}
  </div>
  {% if research.tools %}
    <ul class="research-tools">
      {% for t in research.tools %}
        <li>
          <strong>{{ t.title }}:</strong>
          {{ t.text | markdownify | remove: '<p>' | remove: '</p>' | strip }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
