---
---
{%- comment -%}
  Publication entry template for the home page (used by `{% bibliography --template home_bib %}`).
  Reads these BibTeX fields: title, author, abbr, note (venue line, markdown), preview, arxiv, pdf,
  code, website, video, abstract, bibtex_show.
{%- endcomment -%}
<article class="pub" id="{{ entry.key }}">
  <div class="pub-thumb">
    {%- assign preview_src = nil -%}
    {%- if entry.preview -%}
      {%- if entry.preview contains '://' -%}
        {%- assign preview_src = entry.preview -%}
      {%- else -%}
        {%- assign preview_src = '/assets/img/publication_preview/' | append: entry.preview | relative_url -%}
      {%- endif -%}
    {%- endif -%}
    {%- if entry.preview_video -%}
      {%- assign video_src = '/assets/img/publication_preview/' | append: entry.preview_video | relative_url -%}
      <video
        class="pub-media"
        src="{{ video_src }}"
        {% if preview_src %}poster="{{ preview_src }}"{% endif %}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-label="{{ entry.title | strip_html | escape }}"
      ></video>
    {%- elsif preview_src -%}
      <img class="pub-media" src="{{ preview_src }}" alt="{{ entry.title | strip_html | escape }}" loading="lazy">
    {%- endif -%}
    {%- if entry.abbr -%}<span class="pub-badge">{{ entry.abbr }}</span>{%- endif -%}
  </div>

  <div class="pub-body">
    {%- if entry.arxiv -%}
      {%- assign title_url = 'https://arxiv.org/abs/' | append: entry.arxiv -%}
    {%- elsif entry.website -%}
      {%- assign title_url = entry.website -%}
    {%- elsif entry.pdf -%}
      {%- assign title_url = entry.pdf -%}
    {%- else -%}
      {%- assign title_url = nil -%}
    {%- endif -%}
    <h3 class="pub-title">
      {%- if title_url -%}<a href="{{ title_url }}">{{ entry.title }}</a>{%- else -%}{{ entry.title }}{%- endif -%}
    </h3>

    <div class="pub-authors">
      {%- for author in entry.author_array -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_is_self = false -%}
        {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
          {%- assign author_is_self = true -%}
        {%- endif -%}
        {%- unless forloop.first -%}, {% endunless -%}
        {%- if author_is_self -%}
          <strong>{{ author.first }} {{ author_last_html }}</strong>
        {%- else -%}
          {{ author.first }} {{ author_last_html }}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if entry.note or entry.award -%}
      <div class="pub-venue">
        {%- if entry.note -%}{{ entry.note | markdownify | remove: '<p>' | remove: '</p>' | strip }}{%- endif -%}
        {%- if entry.award -%}
          <span class="pub-award"><i class="fa-solid fa-star"></i>{{ entry.award }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if entry.workshop -%}
      <div class="pub-venue pub-also">
        {%- if entry.workshop_url -%}
          <a href="{{ entry.workshop_url }}">{{ entry.workshop }}</a>
        {%- else -%}
          {{ entry.workshop }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pub-links">
      {%- if entry.arxiv -%}
        <a class="pill" href="https://arxiv.org/abs/{{ entry.arxiv }}"><i class="fa-regular fa-file-lines"></i>arXiv</a>
      {%- endif -%}
      {%- if entry.pdf -%}
        {%- if entry.pdf contains '://' -%}{%- assign pdf_url = entry.pdf -%}{%- else -%}{%- assign pdf_url = '/assets/pdf/' | append: entry.pdf | relative_url -%}{%- endif -%}
        <a class="pill" href="{{ pdf_url }}"><i class="fa-regular fa-file-pdf"></i>PDF</a>
      {%- endif -%}
      {%- if entry.website -%}
        <a class="pill" href="{{ entry.website }}"><i class="fa-solid fa-globe"></i>Project</a>
      {%- endif -%}
      {%- if entry.code -%}
        <a class="pill" href="{{ entry.code }}"><i class="fa-brands fa-github"></i>Code</a>
      {%- endif -%}
      {%- if entry.video -%}
        <a class="pill" href="{{ entry.video }}"><i class="fa-regular fa-circle-play"></i>Video</a>
      {%- endif -%}
      {%- if entry.abstract -%}
        <button class="pill" type="button" data-toggle="abstract" aria-expanded="false">
          <i class="fa-solid fa-align-left"></i>Abstract
        </button>
      {%- endif -%}
      {%- if entry.bibtex_show -%}
        <button class="pill" type="button" data-toggle="bibtex" aria-expanded="false">
          <i class="fa-solid fa-quote-right"></i>BibTeX
        </button>
      {%- endif -%}
    </div>

    {%- if entry.abstract -%}
      <div class="pub-drawer" data-drawer="abstract" hidden><p>{{ entry.abstract }}</p></div>
    {%- endif -%}
    {%- if entry.bibtex_show -%}
      <div class="pub-drawer" data-drawer="bibtex" hidden>
        <pre><code>{{ entry.bibtex | hideCustomBibtex }}</code></pre>
      </div>
    {%- endif -%}
  </div>
</article>
